{
  "name": "taxwise-desktop",
  "productName": "TaxWise Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "TaxWise CRM with WhatsApp Web beside it, for TaxWise Consultants' office PCs.",
  "author": "TaxWise Consultants",
  "homepage": "https://www.twchartered.com",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && node scripts/build.mjs",
    "build:release": "tsc --noEmit -p tsconfig.json && node scripts/build.mjs --release",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "dist": "npm run build:release && electron-builder --publish never",
    "dist:win": "npm run build:release && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build:release && electron-builder --mac dmg --publish never",
    "release": "npm run build:release && electron-builder --publish always --config.forceCodeSigning=true"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
