# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# netlify (CLI state)
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# local tooling
/.taste-skill/
/test-results/
/playwright-report/
# Build output of the removed TaxWise Desktop app, which older checkouts may still have on disk.
/desktop/node_modules/
/desktop/dist/
/desktop/out/
/desktop/dist-build/
/desktop/release/

# agent worktrees (local only)
.claude/worktrees/
