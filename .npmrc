# Type-checking the whole app needs about 2.5 GB of V8 heap (generated Supabase types and every
# typed query), more than Node's ~2 GB default. npm passes this to every script and npx command
# (npm run build / typecheck, npx tsc), so they don't die with "JavaScript heap out of memory".
node-options=--max-old-space-size=4096
