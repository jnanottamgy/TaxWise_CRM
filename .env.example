# TaxWise Practice OS: environment variables (§17)
#
# Copy to .env.local for development. In Vercel, set them per environment (Production = the live
# firm's Supabase project; Preview = staging). Each entry says what breaks without it.
# Check with: npm run env:check   (fails on missing or malformed required values and on example
# values left in place; never prints a value).
#
# Never commit real values. Keep an offline copy of CREDENTIAL_VAULT_KEY.

# --- App ------------------------------------------------------------------------------------------

# production | staging | development | test. Required in production and staging.
# Without it: the app assumes development; staging banners and seed-script guards don't know where
# they are, and env:check applies only the development rules.
APP_ENV=development

# The public URL of this deployment, no trailing path. Required in production and staging (https).
# Without it: links in emails, WhatsApp drafts and the client portal point at http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------------------------------

# Project URL and anon (publishable) key. Required everywhere.
# Without them: nothing works, no sign-in and no data. The anon key is shipped to every browser:
# never paste the service-role key here (env:check refuses it).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role (secret) key, used ONLY by server/admin.ts. Required everywhere.
# Without it: first-run setup, adding staff, inviting portal users, scheduled jobs and the credential
# vault fail. It bypasses Row Level Security: never expose it to the browser (no NEXT_PUBLIC_ prefix;
# scripts/check-service-role.mjs fails the build if it reaches a client bundle).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pooled connection (transaction pooler, port 6543). Recommended in production and staging.
# Without it: database scripts and exports that connect directly can't reach the database.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Direct / session connection (port 5432) for MIGRATIONS. Recommended in production and staging.
# Without it: migrations can't run; schema changes hang through the transaction pooler.
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Credential vault (§12) -----------------------------------------------------------------------

# 64 hex characters (32 bytes). Generate with: openssl rand -hex 32. Required in production and staging.
# Without it: client portal passwords can't be saved or shown. LOSING IT MAKES EVERY STORED PASSWORD
# UNREADABLE: keep an offline copy before any credential is stored (§18.2).
CREDENTIAL_VAULT_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32

# The label stored in front of every sealed value (v1, v2 …). Optional; defaults to v1.
# Without it: v1 is assumed. Change it only when rotating the key.
CREDENTIAL_VAULT_KEY_VERSION=v1

# Only while rotating the vault key: the older keys, as v1:<64 hex>,v2:<64 hex>. Optional.
# Without it during a rotation: values sealed with the old key can't be opened or re-encrypted.
# Remove it once the re-encryption job reports nothing left on the old key.
CREDENTIAL_VAULT_PREVIOUS_KEYS=

# --- Scheduled jobs (§8) --------------------------------------------------------------------------

# At least 32 random characters (openssl rand -hex 32). Required in production and staging.
# Without it: scheduled jobs refuse to run, so nothing happens on schedule (reminders, escalations,
# retainer drafts, attendance, the Partner digest).
CRON_SECRET=replace-with-a-long-random-string

# --- Email: Resend (§7.13.5, §10) -----------------------------------------------------------------

# Resend API key (re_…). Required in production and staging.
# Without it: no email is sent (invites, reminders, invoices, the digest); each record says it didn't go.
RESEND_API_KEY=re_your_resend_api_key

# Resend webhook signing secret (whsec_…). Required in production, recommended in staging.
# Without it: bounce and delivery events are refused, so failed emails aren't marked on their records.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# Default sender and reply-to. Required in production and staging.
# Without them: emails fall back to TaxWise Consultants <noreply@twchartered.com>, replies to
# info@twchartered.com. Settings → Email can override the name and address per firm.
EMAIL_FROM=TaxWise Consultants <noreply@twchartered.com>
EMAIL_REPLY_TO=info@twchartered.com

# --- Bootstrap (§4.3) -----------------------------------------------------------------------------

# The email of the first Partner. Optional; recommended in production and staging.
# Without it: whoever opens /setup first, while no users exist, becomes the first Partner.
FIRST_PARTNER_EMAIL=

# --- TaxWise Desktop (§7.25) ----------------------------------------------------------------------

# Link to the latest signed TaxWise Desktop installer (https). Optional.
# Without it: Settings → WhatsApp shows no Download TaxWise Desktop link.
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=

# TAXWISE_APP_URL is set at build time in desktop/ only (the CRM URL the desktop app loads); it is
# not read by this app. Code-signing secrets live in CI, never in the repository.

# --- Monitoring -----------------------------------------------------------------------------------

# A build identifier (commit or CI run) appended to the version /api/health reports. Optional.
# Without it: /api/health reports the package version only; on Vercel the commit is added anyway
# (VERCEL_GIT_COMMIT_SHA, set by the platform).
APP_BUILD_ID=

# Sentry DSN. Optional.
# Without it: errors are only in the server logs, each with the Ref the user was shown.
SENTRY_DSN=

# --- Local tooling only (not read by the app) ----------------------------------------------------
# LOCAL_PG_ADMIN_URL goes in .env.test.local, never here: the admin connection to a local Postgres 16
# that `npm run db:reset` and `npm run test:db` create their databases in. Without it those scripts
# stop with a message; the app itself is unaffected.
